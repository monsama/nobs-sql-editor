<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package. pack.ps1 fills in the version and packs this next to the exe the
     Tauri build made. Identity Name and Publisher are the ones Partner Center reserved for the app
     (Product management > Product identity); the Store refuses a package whose values differ. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="monsama.NOBSSQLEditor"
    Publisher="CN=83AA0FC0-032F-4377-A730-A1EA43146C8F"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>NOBS SQL Editor</DisplayName>
    <PublisherDisplayName>monsama</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- 1809 and later: WebView2 is part of Windows 11 and of every Windows 10 kept up to date, and an
       MSIX cannot run the WebView2 installer the setup.exe carries. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="NOBSSQLEditor" Executable="nobs-sql-editor.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="NOBS SQL Editor"
        Description="A desktop client for MySQL and MariaDB"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop app: it runs outside the app container, as the setup.exe install does. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
